<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <!-- Repository builds use this adapter; installed consumers use build/native/ARTestSDK.props. -->
    <ARTestJsonIncludeDirectory Condition="'$(ARTestJsonIncludeDirectory)' == ''">$(MSBuildThisFileDirectory)..\ThirdParty</ARTestJsonIncludeDirectory>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <LanguageStandard>stdcpp20</LanguageStandard>
      <PreprocessorDefinitions Condition="'$(ConfigurationType)' == 'DynamicLibrary'">ARTEST_EXTENSION_EXPORTS;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <AdditionalIncludeDirectories>$(MSBuildThisFileDirectory)include;$(ARTestJsonIncludeDirectory);%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
  </ItemDefinitionGroup>
</Project>
