{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://artest.dev/schemas/engine-event-v1.schema.json",
  "title": "ARTest engine event",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "kind", "severity", "source", "message"],
  "properties": {
    "schema": { "const": "artest.schema.engine-event.v1" },
    "kind": { "type": "integer", "minimum": 0 },
    "severity": { "type": "integer", "minimum": 0 },
    "source": { "type": "string" },
    "message": { "type": "string" },
    "stepId": { "type": "integer", "minimum": 1 },
    "attempt": { "type": "integer", "minimum": 1 },
    "durationMs": { "type": "integer", "minimum": 0 },
    "stepStatus": {
      "enum": ["passed", "failed", "error", "skipped", "cancelled", "timedOut"]
    },
    "runStatus": {
      "enum": ["passed", "failed", "error", "cancelled", "timedOut"]
    }
  }
}
