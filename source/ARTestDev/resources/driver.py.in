"""Hardware-free ARTest starter generated by the SDK."""
from dataclasses import dataclass
from artest_sdk import Driver, Extension, Result, operation

EXTENSION_ID = "@EXTENSION@"
CONTRACT = "@CONTRACT@"
READ_OPERATION = CONTRACT + "/read"


@dataclass
class Configuration:
    value: float = 5.0


@dataclass
class ReadParameters:
    channel: int = 1


class SimulatedSource(Driver):
    def __init__(self):
        self.value = 0.0

    async def initialize(self, config, context):
        self.value = config.value
        context.log("GUIDED_DRIVER_INITIALIZE")
        return Result()

    @operation(READ_OPERATION, ReadParameters)
    async def read(self, parameters, context):
        context.check_cancelled()
        return Result({"channel": parameters.channel, "value": self.value},
                      "@EXTENSION@.schema.simulated-source.read.v1")

    async def shutdown(self, context):
        self.value = 0.0
        context.log("GUIDED_DRIVER_SHUTDOWN")
        return Result()


def define_extension():
    extension = Extension(EXTENSION_ID, "0.1.0", "Simulated source", "Example")
    extension.driver(
        "@DRIVER@", SimulatedSource, Configuration,
        name="Simulated source", contract=CONTRACT, simulated=True,
    )
    return extension
