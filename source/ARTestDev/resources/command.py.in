"""Hardware-free ARTest starter generated by the SDK."""
from dataclasses import dataclass
from artest_sdk import Command, Extension, Result, parameter

EXTENSION_ID = "@EXTENSION@"
CONTRACT = "@CONTRACT@"
READ_OPERATION = "com.example.artest.instrument.value-source.v1/read"


@dataclass
class MeasurementParameters:
    factor: float = parameter(default=1.0, minimum=0.0, maximum=10.0)


class MeasureValue(Command):
    async def execute(self, parameters, context):
        async with context.instrument(CONTRACT) as source:
            measurement = await source.invoke(READ_OPERATION, {})
        source_value = measurement.data["value"]
        value = source_value * parameters.factor
        return Result(
            {"value": value, "sourceValue": source_value, "factor": parameters.factor,
             "instrumentId": context.instrument_id},
            "@EXTENSION@.schema.measurement.value.v1",
            message=f"Computed value {value:.6f}.",
        )


def define_extension():
    extension = Extension(EXTENSION_ID, "0.1.0", "Measure a compatible source", "Example")
    extension.command(
        "@COMMAND@", MeasureValue, MeasurementParameters,
        name="Measure value", requires=(CONTRACT,),
    )
    return extension
