{
  "schemaVersion": 1,
  "extensionId": "com.artest.extension.sim-power",
  "displayName": "ARTest Simulated Power Driver",
  "version": "0.1.0",
  "publisher": "ARTest",
  "description": "Reference Instrument Driver used by the Stage D native vertical slice.",
