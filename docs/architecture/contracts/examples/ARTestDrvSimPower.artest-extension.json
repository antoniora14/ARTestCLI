          "mediaType": "application/schema+json"
        },
        {
          "role": "setVoltageRequest",
          "schemaId": "artest.schema.instrument.power-supply.set-voltage.request.v1",
          "path": "schemas/power-supply.set-voltage.request.schema.json",
          "mediaType": "application/schema+json"
        }
